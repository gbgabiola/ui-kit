{
  "name": "ui-kit-storybook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "chromatic": "chromatic --storybook-build-dir storybook-static"
  },
  "dependencies": {
    "@gbgabiola/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2",
    "chromatic": "18.15.3",
    "storybook": "10.6.9",
    "typescript": "~6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
