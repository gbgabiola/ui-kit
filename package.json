{
  "name": "ui-kit-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @gbgabiola/ui build",
    "typecheck": "pnpm --filter ui-kit-demo --filter ui-kit-storybook typecheck",
    "storybook": "pnpm --filter ui-kit-storybook dev",
    "build:storybook": "pnpm --filter ui-kit-storybook build",
    "test": "pnpm --filter ui-kit-storybook test",
    "test:coverage": "pnpm --filter ui-kit-storybook test:coverage",
    "example:react": "bash scripts/package/test-package.sh --dev",
    "test:package": "bash scripts/package/test-package.sh",
    "test:visual": "pnpm --filter ui-kit-storybook test:visual",
    "publish:storybook": "pnpm build:storybook && pnpm --filter ui-kit-storybook chromatic",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "demo": "pnpm build && pnpm --filter ui-kit-demo dev",
    "build:demo": "pnpm build && pnpm --filter ui-kit-demo build",
    "test:demo": "pnpm --filter ui-kit-demo typecheck && pnpm --filter ui-kit-demo exec playwright test",
    "verify:demos": "node scripts/demos/verify-demos.mjs",
    "previews:demos": "node scripts/demos/generate-demo-previews.mjs",
    "demos:sync": "node scripts/demos/sync-demos.mjs",
    "demos:check": "node scripts/demos/sync-demos.mjs --check",
    "component:add": "node scripts/components/add-component.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "check:version": "node scripts/package/check-version.mjs",
    "test:component-workflow": "node scripts/components/test-component-workflow.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0"
  }
}
